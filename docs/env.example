# Template for the private key file. The product reads keys from a file named .env
# inside the directory named by the RC_PRIVATE_DIR environment variable
# ($RC_PRIVATE_DIR/.env, parsed by rc_common.secret() as KEY=VALUE lines; lines
# starting with # are ignored and surrounding quotes are stripped). Keep that
# directory outside this repo. Copy this template there as .env and fill it in.
# MATTERPORT_SDK_KEY may also be set as an ordinary environment variable, which
# takes precedence for the browser tour.
#
# Obtain the values from the data provider. Never commit or print these.
# Matterport Model API key (HTTP basic-auth user name)
MATTERPORT_API_KEY=
# Matterport Model API token (HTTP basic-auth password, the secret half)
MATTERPORT_API_TOKEN=
# Vexcel api_key (sent as the X-API-KEY header; Houston and Los Angeles only)
VEXCEL_API_KEY=
# CoStar kit zip password (from the data provider)
COSTAR_ZIP_PASSWORD=
# CoStar kit download link (optional; the current code does not read it)
COSTAR_KIT_URL=
# Local path to the downloaded CoStar kit zip (required by tools/kit)
COSTAR_KIT_ZIP=
# Matterport Showcase SDK key (browser embed; allowed domain: localhost, http or https)
MATTERPORT_SDK_KEY=
# Matterport GraphiQL playground URL (obtain from the data provider; never share)
MATTERPORT_PLAYGROUND_URL=
